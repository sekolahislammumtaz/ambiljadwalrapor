# ========================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL / Local SQLite)
# ========================================================
#
# PANDUAN KONEKSI SUPABASE:
# Dapatkan di Dashboard Supabase: Project Settings -> Database -> Connection String -> URI
#
# CARA 1 (Direct Connection / Session Pooler - Paling Mudah & Direkomendasikan):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# CARA 2 (Transaction Pooler PgBouncer untuk Vercel Serverless Skala Besar):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# PENGUJIAN LOKAL (Zero-setup SQLite):
DATABASE_URL="file:./dev.db"

# ========================================================
# AUTHENTICATION CREDENTIALS
# ========================================================
# Password default Admin untuk masuk ke /admin
ADMIN_PASSWORD="SiMumtaz123"

# JWT Secret Key untuk enkripsi session cookie (32+ karakter acak)
JWT_SECRET="mumtaz_rapor_jwt_secret_token_secure_2026_xyz"
